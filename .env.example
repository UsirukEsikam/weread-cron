# weread-cron 环境变量示例（复制为 .env 后填写；docker compose 自动读取）。
# 全部用户可见变量带 WEREAD_CRON_ 前缀（ADR-0005）；配置非法即启动失败（exit 1）。

# 初始 Cookie：首次部署必需。微信读书 Cookie header 字符串，形如
#   wr_vid=1111111; wr_skey=abcdef...; wr_gid=123456
# 获取方式见 README「首次 Cookie 配置」。首次部署时取消注释并填写；
# 已存在持久化 Login Session（/data）时无需设置（留空/未设置均可）。
# 值内含 ; = 或 # 等字符时用单引号包裹整行。
# WEREAD_CRON_COOKIE=

# Run Window（HH:MM 24 小时制；start==end = 固定启动时刻；start>end 且不相等非法）
WEREAD_CRON_RUN_WINDOW_START=18:00
WEREAD_CRON_RUN_WINDOW_END=23:00

# Target Duration 随机范围（分钟；min>max 非法）
WEREAD_CRON_READ_MINUTES_MIN=20
WEREAD_CRON_READ_MINUTES_MAX=40

# 候选书（可选，逗号分隔 bookId；留空 = 自动从真实 Shelf 选书）
# WEREAD_CRON_BOOKS=

# 通知渠道（可选；按配置独立启用，均留空 = 不通知）
# WEREAD_CRON_BARK_URL=https://api.day.app/<Bark Key>
# WEREAD_CRON_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<Key>

# 持久化目录（默认 /data；compose 已挂载 ./data:/data，一般无需修改）
# WEREAD_CRON_DATA_DIR=/data

# 时区（默认 Asia/Shanghai；二进制内嵌 tzdata，任意 IANA 时区名均可）
# TZ=Asia/Shanghai
