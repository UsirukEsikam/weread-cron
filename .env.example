# weread-cron 配置示例
# 复制为 .env 文件后按需修改（docker compose 会自动读取）。

# 微信读书登录 Cookie（首次部署必填）
# 获取方法见 README。值通常包含特殊字符，请务必使用英文单引号包裹。
# 注意：如果已有保存的登录状态且不需要更换账号，请保持此行注释；不要取消注释却留空。
# WEREAD_CRON_COOKIE='wr_vid=1111111; wr_skey=abcdef...; wr_gid=123456'

# 每日运行时间窗口（24 小时制，格式 HH:MM）
# 程序会在该区间内随机选择时刻启动阅读；开始与结束时间相同表示在固定时刻启动。
WEREAD_CRON_RUN_WINDOW_START=18:00
WEREAD_CRON_RUN_WINDOW_END=23:00

# 每次阅读时长范围（分钟）
# 每次任务会在设定的最小和最大时长之间随机决定实际阅读时间。
WEREAD_CRON_READ_MINUTES_MIN=20
WEREAD_CRON_READ_MINUTES_MAX=40

# 指定阅读的书籍 ID（可选，多本书籍 ID 用英文逗号隔开；留空则自动从书架挑选）
# WEREAD_CRON_BOOKS=

# 消息通知地址（可选，配置后生效；留空则不发送通知）
# WEREAD_CRON_BARK_URL=https://api.day.app/<Bark_Key>
# WEREAD_CRON_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<Key>

# 数据保存目录（可选，默认 /data；使用默认 Compose 配置时无需修改）
# WEREAD_CRON_DATA_DIR=/data

# 时区（可选，默认 Asia/Shanghai）
# TZ=Asia/Shanghai
