# weread-cron 部署模板
# 复制为 compose.yaml 后使用。

services:
  weread-cron:
    image: ghcr.io/UsirukEsikam/weread-cron:latest
    restart: unless-stopped
    env_file:
      - .env
    environment:
      TZ: ${TZ:-Asia/Shanghai}
    volumes:
      - weread-cron-data:/data

volumes:
  weread-cron-data:
    # 固定数据卷名称，避免因目录变动导致新建卷而丢失数据
    name: weread-cron-data
